<resources>
    <style name="Theme.Muyassir" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Splash: calm paper background, the mark on its ink tile (Android 12+ draws the circle). -->
    <style name="Theme.Muyassir.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Muyassir</item>
    </style>
</resources>
